ANTHROPIC_API_KEY=
# 允許呼叫 API 的前端來源，逗號分隔。Capacitor App 的來源是 capacitor://localhost（iOS）與 https://localhost（Android）
ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost
# 選填：覆寫模型
STORY_MODEL=claude-opus-5-5

# 速率限制。正式上線必須設定 Upstash Redis，否則 serverless 各實例分開計數，擋不住刷量
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_IP_PER_MINUTE=5
RATE_IP_PER_DAY=50
# 全站每日故事總量上限（費用封頂）
RATE_GLOBAL_PER_DAY=2000

# 雲端朗讀（Azure Speech 神經語音）。兩個都沒設定時 /api/tts 回 503，前端自動改用裝置內建語音
# 金鑰與區域在 Azure Portal → Speech 資源 → Keys and Endpoint，區域例如 eastasia、japaneast
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# 朗讀的速率限制（跟故事分開計數）。10 分鐘的故事約 24 段、每段一次請求
RATE_TTS_IP_PER_MINUTE=60
RATE_TTS_IP_PER_DAY=800
# 全站每日朗讀請求上限（Azure 費用封頂）
RATE_TTS_GLOBAL_PER_DAY=50000
